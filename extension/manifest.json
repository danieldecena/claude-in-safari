{
  "manifest_version": 3,
  "name": "Claude in Safari",
  "version": "0.1.0",
  "description": "Lets Claude Code drive Safari tabs through a local MCP bridge.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
