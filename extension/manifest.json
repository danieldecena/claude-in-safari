{
  "manifest_version": 2,
  "name": "Claude in Safari",
  "version": "0.1.0",
  "description": "Lets Claude Code drive Safari tabs through a local MCP bridge.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "alarms",
    "webNavigation",
    "<all_urls>"
  ],
  "browser_action": {
    "default_title": "Claude in Safari",
    "default_icon": {
      "16": "images/toolbar-16.png",
      "18": "images/toolbar-18.png",
      "19": "images/toolbar-19.png",
      "20": "images/toolbar-20.png",
      "24": "images/toolbar-24.png",
      "32": "images/toolbar-32.png",
      "36": "images/toolbar-36.png",
      "38": "images/toolbar-38.png",
      "40": "images/toolbar-40.png",
      "48": "images/toolbar-48.png",
      "64": "images/toolbar-64.png",
      "96": "images/toolbar-96.png",
      "128": "images/toolbar-128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
