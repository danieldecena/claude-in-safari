{
  "manifest_version": 2,
  "name": "Claude in Safari",
  "version": "0.1.0",
  "description": "Lets Claude Code drive Safari tabs through a local MCP bridge.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "alarms",
    "webNavigation",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
